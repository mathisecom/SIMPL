{% liquid
  assign sid = 'social-gallery-' | append: section.id
%}

<section
  id="{{ sid }}"
  class="social-gallery social-gallery--{{ section.settings.image_ratio }}"
  style="
    --sg-bg: {{ section.settings.background }};
    --sg-text: {{ section.settings.text_color }};
    --sg-muted: {{ section.settings.muted_color }};
    --sg-social-bg: {{ section.settings.social_background }};
    --sg-social-color: {{ section.settings.social_color }};
    --sg-width: {{ section.settings.content_width }}px;
    --sg-cols-desktop: {{ section.settings.columns_desktop }};
    --sg-cols-mobile: {{ section.settings.columns_mobile }};
    --sg-gap-desktop: {{ section.settings.gap_desktop }}px;
    --sg-gap-mobile: {{ section.settings.gap_mobile }}px;
    --sg-title-desktop: {{ section.settings.title_size_desktop }}px;
    --sg-title-mobile: {{ section.settings.title_size_mobile }}px;
    --sg-radius: {{ section.settings.image_radius }}px;
    --sg-pad-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --sg-pad-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --sg-pad-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --sg-pad-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="social-gallery__inner">
    <header class="social-gallery__header social-gallery__header--{{ section.settings.alignment }}">
      {% if section.settings.eyebrow != blank %}
        <p class="social-gallery__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="social-gallery__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="social-gallery__text rte">{{ section.settings.text }}</div>
      {% endif %}
    </header>

    {% if section.settings.show_socials %}
      <div class="social-gallery__socials" aria-label="{{ section.settings.social_label | escape }}">
        {% if section.settings.instagram != blank %}
          <a href="{{ section.settings.instagram }}" aria-label="Instagram" class="social-gallery__social" {% if section.settings.new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
            <svg viewBox="0 0 24 24" role="presentation"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg>
          </a>
        {% endif %}
        {% if section.settings.facebook != blank %}
          <a href="{{ section.settings.facebook }}" aria-label="Facebook" class="social-gallery__social" {% if section.settings.new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
            <svg viewBox="0 0 24 24" role="presentation"><path d="M14.5 8H17V4.3c-.8-.1-1.8-.3-3.1-.3-3.1 0-5.2 1.9-5.2 5.4V12H5.2v4.2h3.5V24H13v-7.8h3.5L17 12h-4V9.8c0-1.2.3-1.8 1.5-1.8Z"></path></svg>
          </a>
        {% endif %}
        {% if section.settings.tiktok != blank %}
          <a href="{{ section.settings.tiktok }}" aria-label="TikTok" class="social-gallery__social" {% if section.settings.new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
            <svg viewBox="0 0 24 24" role="presentation"><path d="M15.2 4c.4 2.5 1.9 4 4.3 4.2v3.2c-1.6 0-3.1-.5-4.3-1.4v6.1a6.1 6.1 0 1 1-5.3-6v3.3a2.9 2.9 0 1 0 2 2.7V4h3.3Z"></path></svg>
          </a>
        {% endif %}
        {% if section.settings.linkedin != blank %}
          <a href="{{ section.settings.linkedin }}" aria-label="LinkedIn" class="social-gallery__social" {% if section.settings.new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
            <svg viewBox="0 0 24 24" role="presentation"><rect x="3" y="9" width="4" height="12"></rect><circle cx="5" cy="5" r="2"></circle><path d="M11 21V9h4v1.7c.9-1.3 2.2-2.1 4-2.1 3.1 0 4 2 4 5.2V21h-4v-6.4c0-1.5-.5-2.6-1.9-2.6-1.7 0-2.1 1.3-2.1 3.3V21h-4Z"></path></svg>
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="social-gallery__grid" role="list">
      {% for block in section.blocks %}
        {% liquid
          assign tag = 'div'
          if block.settings.link != blank
            assign tag = 'a'
          endif
          assign alt = block.settings.image.alt | default: block.settings.title
        %}
        <{{ tag }}
          class="social-gallery__item"
          {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% if block.settings.open_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}{% endif %}
          role="listitem"
          {{ block.shopify_attributes }}
        >
          <div class="social-gallery__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '240,360,480,640,800,1000,1200,1400', sizes: '(min-width: 990px) 20vw, 50vw', class: 'social-gallery__image', alt: alt }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'social-gallery__placeholder' }}
            {% endif %}

            {% if block.settings.badge != blank %}
              <span class="social-gallery__badge">{{ block.settings.badge | escape }}</span>
            {% endif %}

            {% if block.settings.title != blank or block.settings.caption != blank %}
              <div class="social-gallery__caption">
                {% if block.settings.title != blank %}<p class="social-gallery__item-title">{{ block.settings.title | escape }}</p>{% endif %}
                {% if block.settings.caption != blank %}<p class="social-gallery__item-caption">{{ block.settings.caption | escape }}</p>{% endif %}
              </div>
            {% endif %}
          </div>
        </{{ tag }}>
      {% else %}
        <p class="social-gallery__empty">Ajoutez des images dans l’éditeur Shopify.</p>
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  #{{ sid }} {
    width: 100%;
    padding-block: var(--sg-pad-top-desktop) var(--sg-pad-bottom-desktop);
    background: var(--sg-bg);
    color: var(--sg-text);
  }
  #{{ sid }} *, #{{ sid }} *::before, #{{ sid }} *::after { box-sizing: border-box; }
  #{{ sid }} .social-gallery__inner { width: min(calc(100% - 40px), var(--sg-width)); margin-inline: auto; }
  #{{ sid }} .social-gallery__header { max-width: {{ section.settings.header_width }}px; margin-bottom: {{ section.settings.header_spacing }}px; }
  #{{ sid }} .social-gallery__header--left { margin-right: auto; text-align: left; }
  #{{ sid }} .social-gallery__header--center { margin-inline: auto; text-align: center; }
  #{{ sid }} .social-gallery__header--right { margin-left: auto; text-align: right; }
  #{{ sid }} .social-gallery__eyebrow { margin: 0 0 10px; color: var(--sg-muted); font-size: 12px; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
  #{{ sid }} .social-gallery__heading { margin: 0; color: var(--sg-text); font-size: var(--sg-title-desktop); font-weight: {{ section.settings.title_weight }}; letter-spacing: -.04em; line-height: 1; text-transform: {% if section.settings.uppercase %}uppercase{% else %}none{% endif %}; }
  #{{ sid }} .social-gallery__text { margin-top: 14px; color: var(--sg-muted); font-size: {{ section.settings.text_size_desktop }}px; line-height: 1.5; }
  #{{ sid }} .social-gallery__text > *:first-child { margin-top: 0; }
  #{{ sid }} .social-gallery__text > *:last-child { margin-bottom: 0; }
  #{{ sid }} .social-gallery__socials { display: flex; justify-content: center; flex-wrap: wrap; gap: {{ section.settings.social_gap }}px; margin-bottom: {{ section.settings.social_spacing }}px; }
  #{{ sid }} .social-gallery__social { display: grid; width: {{ section.settings.social_size }}px; height: {{ section.settings.social_size }}px; place-items: center; border-radius: {{ section.settings.social_radius }}px; background: var(--sg-social-bg); color: var(--sg-social-color); transform: skewX({{ section.settings.social_skew }}deg); text-decoration: none; transition: transform .18s ease, opacity .18s ease; }
  #{{ sid }} .social-gallery__social svg { width: 54%; height: 54%; fill: currentColor; stroke: currentColor; stroke-width: 1.7; transform: skewX({{ section.settings.social_skew | times: -1 }}deg); }
  #{{ sid }} .social-gallery__social rect, #{{ sid }} .social-gallery__social circle { fill: none; }
  #{{ sid }} .social-gallery__grid { display: grid; grid-template-columns: repeat(var(--sg-cols-desktop), minmax(0,1fr)); gap: var(--sg-gap-desktop); }
  #{{ sid }} .social-gallery__item { display: block; min-width: 0; color: inherit; text-decoration: none; }
  #{{ sid }} .social-gallery__media { position: relative; overflow: hidden; width: 100%; border-radius: var(--sg-radius); background: rgba(0,0,0,.05); }
  #{{ sid }}.social-gallery--square .social-gallery__media { aspect-ratio: 1/1; }
  #{{ sid }}.social-gallery--portrait .social-gallery__media { aspect-ratio: 4/5; }
  #{{ sid }}.social-gallery--landscape .social-gallery__media { aspect-ratio: 4/3; }
  #{{ sid }}.social-gallery--wide .social-gallery__media { aspect-ratio: 16/10; }
  #{{ sid }} .social-gallery__image, #{{ sid }} .social-gallery__placeholder { display: block; width: 100%; height: 100%; }
  #{{ sid }} .social-gallery__image { object-fit: {{ section.settings.image_fit }}; transition: transform .4s ease; }
  #{{ sid }} .social-gallery__badge { position: absolute; top: 10px; left: 10px; padding: 5px 9px; border-radius: 999px; background: var(--sg-social-bg); color: var(--sg-social-color); font-size: 9px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  #{{ sid }} .social-gallery__caption { position: absolute; right: 0; bottom: 0; left: 0; padding: 18px; color: #fff; background: linear-gradient(to top, rgba(0,0,0,.72), transparent); }
  #{{ sid }} .social-gallery__item-title { margin: 0; font-size: 16px; font-weight: 800; line-height: 1.15; }
  #{{ sid }} .social-gallery__item-caption { margin: 5px 0 0; font-size: 12px; line-height: 1.3; opacity: .86; }
  #{{ sid }} .social-gallery__empty { grid-column: 1/-1; margin: 0; padding: 24px; text-align: center; }
  @media (hover:hover) {
    #{{ sid }} .social-gallery__social:hover { transform: skewX({{ section.settings.social_skew }}deg) translateY(-2px); opacity: .85; }
    #{{ sid }} .social-gallery__item[href]:hover .social-gallery__image { transform: scale(1.04); }
  }
  @media screen and (max-width:749px) {
    #{{ sid }} { padding-block: var(--sg-pad-top-mobile) var(--sg-pad-bottom-mobile); }
    #{{ sid }} .social-gallery__inner { width: min(calc(100% - 28px), var(--sg-width)); }
    #{{ sid }} .social-gallery__header { margin-bottom: {{ section.settings.header_spacing_mobile }}px; }
    #{{ sid }} .social-gallery__heading { font-size: var(--sg-title-mobile); }
    #{{ sid }} .social-gallery__text { font-size: {{ section.settings.text_size_mobile }}px; }
    #{{ sid }} .social-gallery__socials { gap: {{ section.settings.social_gap_mobile }}px; margin-bottom: {{ section.settings.social_spacing_mobile }}px; }
    #{{ sid }} .social-gallery__social { width: {{ section.settings.social_size_mobile }}px; height: {{ section.settings.social_size_mobile }}px; }
    #{{ sid }} .social-gallery__grid { grid-template-columns: repeat(var(--sg-cols-mobile), minmax(0,1fr)); gap: var(--sg-gap-mobile); }
    #{{ sid }} .social-gallery__caption { padding: 12px; }
    #{{ sid }} .social-gallery__item-title { font-size: 13px; }
    #{{ sid }} .social-gallery__item-caption { font-size: 10px; }
  }
  @media (prefers-reduced-motion:reduce) {
    #{{ sid }} .social-gallery__social, #{{ sid }} .social-gallery__image { transition: none; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Réseaux + galerie",
  "tag": "section",
  "class": "section-social-gallery",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "En-tête" },
    { "type": "text", "id": "eyebrow", "label": "Petit titre", "default": "SUIVEZ-NOUS" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "RESTONS CONNECTÉS" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Découvrez nos nouveautés, conseils et coulisses.</p>" },
    { "type": "select", "id": "alignment", "label": "Alignement", "default": "center", "options": [
      { "value": "left", "label": "Gauche" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Droite" }
    ]},
    { "type": "checkbox", "id": "uppercase", "label": "Titre en majuscules", "default": true },
    { "type": "select", "id": "title_weight", "label": "Graisse du titre", "default": "800", "options": [
      { "value": "600", "label": "Semi-grasse" }, { "value": "700", "label": "Grasse" }, { "value": "800", "label": "Très grasse" }
    ]},
    { "type": "range", "id": "title_size_desktop", "label": "Taille du titre sur ordinateur", "min": 28, "max": 72, "step": 2, "unit": "px", "default": 44 },
    { "type": "range", "id": "title_size_mobile", "label": "Taille du titre sur mobile", "min": 22, "max": 48, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "text_size_desktop", "label": "Taille du texte sur ordinateur", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "text_size_mobile", "label": "Taille du texte sur mobile", "min": 11, "max": 18, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "header_width", "label": "Largeur maximale de l’en-tête", "min": 400, "max": 1200, "step": 50, "unit": "px", "default": 800 },
    { "type": "range", "id": "header_spacing", "label": "Espace sous l’en-tête", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "header_spacing_mobile", "label": "Espace sous l’en-tête sur mobile", "min": 0, "max": 60, "step": 4, "unit": "px", "default": 20 },

    { "type": "header", "content": "Réseaux sociaux" },
    { "type": "checkbox", "id": "show_socials", "label": "Afficher les réseaux", "default": true },
    { "type": "text", "id": "social_label", "label": "Description d’accessibilité", "default": "Nos réseaux sociaux" },
    { "type": "url", "id": "instagram", "label": "Lien Instagram" },
    { "type": "url", "id": "facebook", "label": "Lien Facebook" },
    { "type": "url", "id": "tiktok", "label": "Lien TikTok" },
    { "type": "url", "id": "linkedin", "label": "Lien LinkedIn" },
    { "type": "checkbox", "id": "new_tab", "label": "Ouvrir dans un nouvel onglet", "default": true },
    { "type": "range", "id": "social_size", "label": "Taille des boutons sociaux", "min": 28, "max": 60, "step": 2, "unit": "px", "default": 38 },
    { "type": "range", "id": "social_size_mobile", "label": "Taille des boutons sur mobile", "min": 26, "max": 52, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "social_gap", "label": "Espace entre les réseaux", "min": 4, "max": 30, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "social_gap_mobile", "label": "Espace entre les réseaux sur mobile", "min": 4, "max": 24, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "social_spacing", "label": "Espace sous les réseaux", "min": 8, "max": 80, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "social_spacing_mobile", "label": "Espace sous les réseaux sur mobile", "min": 8, "max": 60, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "social_radius", "label": "Arrondi des boutons sociaux", "min": 0, "max": 20, "step": 2, "unit": "px", "default": 2 },
    { "type": "range", "id": "social_skew", "label": "Inclinaison des boutons sociaux", "min": -14, "max": 0, "step": 1, "unit": "deg", "default": -8 },

    { "type": "header", "content": "Galerie" },
    { "type": "range", "id": "content_width", "label": "Largeur maximale", "min": 900, "max": 2000, "step": 50, "unit": "px", "default": 1800 },
    { "type": "select", "id": "columns_desktop", "label": "Colonnes sur ordinateur", "default": "5", "options": [
      { "value": "3", "label": "3 colonnes" }, { "value": "4", "label": "4 colonnes" }, { "value": "5", "label": "5 colonnes" }, { "value": "6", "label": "6 colonnes" }
    ]},
    { "type": "select", "id": "columns_mobile", "label": "Colonnes sur mobile", "default": "2", "options": [
      { "value": "1", "label": "1 colonne" }, { "value": "2", "label": "2 colonnes" }
    ]},
    { "type": "select", "id": "image_ratio", "label": "Format des images", "default": "square", "options": [
      { "value": "square", "label": "Carré" }, { "value": "portrait", "label": "Portrait" }, { "value": "landscape", "label": "Paysage" }, { "value": "wide", "label": "Large" }
    ]},
    { "type": "select", "id": "image_fit", "label": "Ajustement des images", "default": "cover", "options": [
      { "value": "cover", "label": "Remplir" }, { "value": "contain", "label": "Afficher entièrement" }
    ]},
    { "type": "range", "id": "gap_desktop", "label": "Espacement entre les images", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "gap_mobile", "label": "Espacement sur mobile", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "image_radius", "label": "Arrondi des images", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },

    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "background", "label": "Fond de la section", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Texte principal", "default": "#2B2B2B" },
    { "type": "color", "id": "muted_color", "label": "Texte secondaire", "default": "#777777" },
    { "type": "color", "id": "social_background", "label": "Fond des réseaux", "default": "#0021EF" },
    { "type": "color", "id": "social_color", "label": "Couleur des icônes", "default": "#FFFFFF" },

    { "type": "header", "content": "Espacement de la section" },
    { "type": "range", "id": "padding_top_desktop", "label": "Espace supérieur sur ordinateur", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Espace inférieur sur ordinateur", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_top_mobile", "label": "Espace supérieur sur mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Espace inférieur sur mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 }
  ],
  "blocks": [
    {
      "type": "gallery_item",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "NOUVEAU" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Notre univers" },
        { "type": "text", "id": "caption", "label": "Sous-titre", "default": "Découvrez les coulisses" },
        { "type": "url", "id": "link", "label": "Lien" },
        { "type": "checkbox", "id": "open_new_tab", "label": "Ouvrir dans un nouvel onglet", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Réseaux + galerie",
      "blocks": [
        { "type": "gallery_item" },
        { "type": "gallery_item" },
        { "type": "gallery_item" },
        { "type": "gallery_item" },
        { "type": "gallery_item" }
      ]
    }
  ]
}
{% endschema %}