{% liquid
  assign sid = 'social-slider-' | append: section.id
%}

<section
  id="{{ sid }}"
  class="
    social-slider
    social-slider--{{ section.settings.image_ratio }}
    social-slider--arrows-{{ section.settings.arrow_position }}
  "
  data-slider
  data-visible-desktop="{{ section.settings.slides_desktop }}"
  data-visible-tablet="{{ section.settings.slides_tablet }}"
  data-visible-mobile="{{ section.settings.slides_mobile }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-delay="{{ section.settings.autoplay_speed | times: 1000 }}"
  data-loop="{{ section.settings.loop }}"
  style="
    --ss-bg: {{ section.settings.background }};
    --ss-text: {{ section.settings.text_color }};
    --ss-muted: {{ section.settings.muted_color }};
    --ss-social-bg: {{ section.settings.social_background }};
    --ss-social-color: {{ section.settings.social_color }};
    --ss-arrow-bg: {{ section.settings.arrow_background }};
    --ss-arrow-color: {{ section.settings.arrow_color }};
    --ss-dot: {{ section.settings.dot_color }};
    --ss-dot-active: {{ section.settings.dot_active_color }};
    --ss-width: {{ section.settings.content_width }}px;
    --ss-visible: {{ section.settings.slides_desktop }};
    --ss-gap: {{ section.settings.gap_desktop }}px;
    --ss-title-desktop: {{ section.settings.title_size_desktop }}px;
    --ss-title-mobile: {{ section.settings.title_size_mobile }}px;
    --ss-radius: {{ section.settings.image_radius }}px;
    --ss-arrow-size: {{ section.settings.arrow_size }}px;
    --ss-pad-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --ss-pad-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --ss-pad-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --ss-pad-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="social-slider__inner">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank %}
      <header class="social-slider__header social-slider__header--{{ section.settings.alignment }}">
        {% if section.settings.eyebrow != blank %}
          <p class="social-slider__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="social-slider__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="social-slider__text rte">{{ section.settings.text }}</div>
        {% endif %}
      </header>
    {% endif %}

    {% if section.settings.show_socials %}
      <nav class="social-slider__socials" aria-label="{{ section.settings.social_label | escape }}">
        {% if section.settings.instagram != blank %}
          <a
            href="{{ section.settings.instagram }}"
            aria-label="Instagram"
            class="social-slider__social"
            {% if section.settings.new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
          >
            <svg viewBox="0 0 24 24" role="presentation">
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="1"></circle>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.facebook != blank %}
          <a
            href="{{ section.settings.facebook }}"
            aria-label="Facebook"
            class="social-slider__social"
            {% if section.settings.new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
          >
            <svg viewBox="0 0 24 24" role="presentation">
              <path d="M14.5 8H17V4.3c-.8-.1-1.8-.3-3.1-.3-3.1 0-5.2 1.9-5.2 5.4V12H5.2v4.2h3.5V24H13v-7.8h3.5L17 12h-4V9.8c0-1.2.3-1.8 1.5-1.8Z"></path>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.tiktok != blank %}
          <a
            href="{{ section.settings.tiktok }}"
            aria-label="TikTok"
            class="social-slider__social"
            {% if section.settings.new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
          >
            <svg viewBox="0 0 24 24" role="presentation">
              <path d="M15.2 4c.4 2.5 1.9 4 4.3 4.2v3.2c-1.6 0-3.1-.5-4.3-1.4v6.1a6.1 6.1 0 1 1-5.3-6v3.3a2.9 2.9 0 1 0 2 2.7V4h3.3Z"></path>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.linkedin != blank %}
          <a
            href="{{ section.settings.linkedin }}"
            aria-label="LinkedIn"
            class="social-slider__social"
            {% if section.settings.new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
          >
            <svg viewBox="0 0 24 24" role="presentation">
              <rect x="3" y="9" width="4" height="12"></rect>
              <circle cx="5" cy="5" r="2"></circle>
              <path d="M11 21V9h4v1.7c.9-1.3 2.2-2.1 4-2.1 3.1 0 4 2 4 5.2V21h-4v-6.4c0-1.5-.5-2.6-1.9-2.6-1.7 0-2.1 1.3-2.1 3.3V21h-4Z"></path>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.youtube != blank %}
          <a
            href="{{ section.settings.youtube }}"
            aria-label="YouTube"
            class="social-slider__social"
            {% if section.settings.new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
          >
            <svg viewBox="0 0 24 24" role="presentation">
              <path d="M21 8.2a3 3 0 0 0-2.1-2.1C17 5.6 12 5.6 12 5.6s-5 0-6.9.5A3 3 0 0 0 3 8.2 31 31 0 0 0 2.5 12 31 31 0 0 0 3 15.8a3 3 0 0 0 2.1 2.1c1.9.5 6.9.5 6.9.5s5 0 6.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-3.8 31 31 0 0 0-.5-3.8Z"></path>
              <path d="m10 15.2 5.2-3.2L10 8.8v6.4Z" class="social-slider__youtube-play"></path>
            </svg>
          </a>
        {% endif %}
      </nav>
    {% endif %}

    <div class="social-slider__shell">
      {% if section.settings.show_arrows %}
        <button
          type="button"
          class="social-slider__arrow social-slider__arrow--previous"
          aria-label="Afficher les images précédentes"
          data-slider-previous
        >
          <svg viewBox="0 0 24 24" role="presentation">
            <path d="m15 5-7 7 7 7"></path>
          </svg>
        </button>
      {% endif %}

      <div
        class="social-slider__viewport"
        data-slider-viewport
        role="region"
        aria-roledescription="carrousel"
        aria-label="{{ section.settings.slider_label | escape }}"
        tabindex="0"
      >
        <div class="social-slider__track" data-slider-track role="list">
          {% for block in section.blocks %}
            {% liquid
              assign item_tag = 'div'
              if block.settings.link != blank
                assign item_tag = 'a'
              endif
              assign image_alt = block.settings.image.alt | default: block.settings.title
            %}

            <{{ item_tag }}
              class="social-slider__item"
              data-slider-item
              {% if block.settings.link != blank %}
                href="{{ block.settings.link }}"
                {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                aria-label="{{ block.settings.title | escape }}"
              {% endif %}
              role="group"
              aria-roledescription="diapositive"
              aria-label="{{ forloop.index }} sur {{ section.blocks.size }}"
              {{ block.shopify_attributes }}
            >
              <div class="social-slider__media">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 1600
                    | image_tag:
                      loading: 'lazy',
                      widths: '240, 360, 480, 640, 800, 1000, 1200, 1400, 1600',
                      sizes: '(min-width: 990px) 20vw, (min-width: 750px) 33vw, 50vw',
                      class: 'social-slider__image',
                      alt: image_alt
                  }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'social-slider__placeholder' }}
                {% endif %}

                {% if block.settings.badge != blank %}
                  <span class="social-slider__badge">{{ block.settings.badge | escape }}</span>
                {% endif %}

                {% if block.settings.title != blank or block.settings.caption != blank %}
                  <div class="social-slider__caption">
                    {% if block.settings.title != blank %}
                      <p class="social-slider__item-title">{{ block.settings.title | escape }}</p>
                    {% endif %}

                    {% if block.settings.caption != blank %}
                      <p class="social-slider__item-caption">{{ block.settings.caption | escape }}</p>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </{{ item_tag }}>
          {% else %}
            <div class="social-slider__empty">
              Ajoutez des images dans l’éditeur Shopify.
            </div>
          {% endfor %}
        </div>
      </div>

      {% if section.settings.show_arrows %}
        <button
          type="button"
          class="social-slider__arrow social-slider__arrow--next"
          aria-label="Afficher les images suivantes"
          data-slider-next
        >
          <svg viewBox="0 0 24 24" role="presentation">
            <path d="m9 5 7 7-7 7"></path>
          </svg>
        </button>
      {% endif %}
    </div>

    {% if section.settings.show_dots %}
      <div class="social-slider__dots" data-slider-dots aria-label="Navigation du carrousel"></div>
    {% endif %}
  </div>
</section>

{% style %}
  #{{ sid }} {
    width: 100%;
    padding-block: var(--ss-pad-top-desktop) var(--ss-pad-bottom-desktop);
    overflow: hidden;
    background: var(--ss-bg);
    color: var(--ss-text);
  }

  #{{ sid }} *,
  #{{ sid }} *::before,
  #{{ sid }} *::after {
    box-sizing: border-box;
  }

  #{{ sid }} .social-slider__inner {
    width: min(calc(100% - 40px), var(--ss-width));
    margin-inline: auto;
  }

  #{{ sid }} .social-slider__header {
    max-width: {{ section.settings.header_width }}px;
    margin-bottom: {{ section.settings.header_spacing }}px;
  }

  #{{ sid }} .social-slider__header--left {
    margin-right: auto;
    text-align: left;
  }

  #{{ sid }} .social-slider__header--center {
    margin-inline: auto;
    text-align: center;
  }

  #{{ sid }} .social-slider__header--right {
    margin-left: auto;
    text-align: right;
  }

  #{{ sid }} .social-slider__eyebrow {
    margin: 0 0 10px;
    color: var(--ss-muted);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.15em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #{{ sid }} .social-slider__heading {
    margin: 0;
    color: var(--ss-text);
    font-size: var(--ss-title-desktop);
    font-weight: {{ section.settings.title_weight }};
    letter-spacing: -0.04em;
    line-height: 1;
    text-transform: {% if section.settings.uppercase %}uppercase{% else %}none{% endif %};
  }

  #{{ sid }} .social-slider__text {
    margin-top: 14px;
    color: var(--ss-muted);
    font-size: {{ section.settings.text_size_desktop }}px;
    line-height: 1.5;
  }

  #{{ sid }} .social-slider__text > *:first-child {
    margin-top: 0;
  }

  #{{ sid }} .social-slider__text > *:last-child {
    margin-bottom: 0;
  }

  #{{ sid }} .social-slider__socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: {{ section.settings.social_gap }}px;
    margin-bottom: {{ section.settings.social_spacing }}px;
  }

  #{{ sid }} .social-slider__social {
    display: grid;
    width: {{ section.settings.social_size }}px;
    height: {{ section.settings.social_size }}px;
    place-items: center;
    border-radius: {{ section.settings.social_radius }}px;
    background: var(--ss-social-bg);
    color: var(--ss-social-color);
    text-decoration: none;
    transform: skewX({{ section.settings.social_skew }}deg);
    transition: transform 180ms ease, opacity 180ms ease;
  }

  #{{ sid }} .social-slider__social svg {
    width: 54%;
    height: 54%;
    fill: currentColor;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
    transform: skewX({{ section.settings.social_skew | times: -1 }}deg);
  }

  #{{ sid }} .social-slider__social rect,
  #{{ sid }} .social-slider__social circle {
    fill: none;
  }

  #{{ sid }} .social-slider__social .social-slider__youtube-play {
    fill: var(--ss-social-bg);
    stroke: var(--ss-social-bg);
  }

  #{{ sid }} .social-slider__shell {
    position: relative;
  }

  #{{ sid }} .social-slider__viewport {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-inline: contain;
    -webkit-overflow-scrolling: touch;
  }

  #{{ sid }} .social-slider__viewport::-webkit-scrollbar {
    display: none;
  }

  #{{ sid }} .social-slider__track {
    display: flex;
    gap: var(--ss-gap);
    width: 100%;
  }

  #{{ sid }} .social-slider__item {
    flex: 0 0 calc(
      (100% - (var(--ss-visible) - 1) * var(--ss-gap)) / var(--ss-visible)
    );
    min-width: 0;
    color: inherit;
    text-decoration: none;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  #{{ sid }} .social-slider__media {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--ss-radius);
    background: rgba(0, 0, 0, 0.05);
  }

  #{{ sid }}.social-slider--square .social-slider__media {
    aspect-ratio: 1 / 1;
  }

  #{{ sid }}.social-slider--portrait .social-slider__media {
    aspect-ratio: 4 / 5;
  }

  #{{ sid }}.social-slider--landscape .social-slider__media {
    aspect-ratio: 4 / 3;
  }

  #{{ sid }}.social-slider--wide .social-slider__media {
    aspect-ratio: 16 / 10;
  }

  #{{ sid }} .social-slider__image,
  #{{ sid }} .social-slider__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  #{{ sid }} .social-slider__image {
    object-fit: {{ section.settings.image_fit }};
    transition: transform 400ms ease;
  }

  #{{ sid }} .social-slider__placeholder {
    background: rgba(0, 0, 0, 0.05);
  }

  #{{ sid }} .social-slider__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 5px 9px;
    border-radius: 999px;
    background: var(--ss-social-bg);
    color: var(--ss-social-color);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  #{{ sid }} .social-slider__caption {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 18px;
    color: #ffffff;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.72), transparent);
  }

  #{{ sid }} .social-slider__item-title {
    margin: 0;
    font-size: 16px;
    font-weight: 800;
    line-height: 1.15;
  }

  #{{ sid }} .social-slider__item-caption {
    margin: 5px 0 0;
    font-size: 12px;
    line-height: 1.3;
    opacity: 0.86;
  }

  #{{ sid }} .social-slider__arrow {
    position: absolute;
    z-index: 3;
    top: 50%;
    display: grid;
    width: var(--ss-arrow-size);
    height: var(--ss-arrow-size);
    padding: 0;
    transform: translateY(-50%);
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: var(--ss-arrow-bg);
    color: var(--ss-arrow-color);
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    transition: transform 180ms ease, opacity 180ms ease;
  }

  #{{ sid }} .social-slider__arrow svg {
    width: 46%;
    height: 46%;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.2;
  }

  #{{ sid }} .social-slider__arrow--previous {
    left: 12px;
  }

  #{{ sid }} .social-slider__arrow--next {
    right: 12px;
  }

  #{{ sid }}.social-slider--arrows-outside .social-slider__arrow--previous {
    left: calc(var(--ss-arrow-size) / -2);
  }

  #{{ sid }}.social-slider--arrows-outside .social-slider__arrow--next {
    right: calc(var(--ss-arrow-size) / -2);
  }

  #{{ sid }} .social-slider__arrow[hidden] {
    display: none;
  }

  #{{ sid }} .social-slider__dots {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: {{ section.settings.dots_spacing }}px;
  }

  #{{ sid }} .social-slider__dot {
    width: {{ section.settings.dot_size }}px;
    height: {{ section.settings.dot_size }}px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--ss-dot);
    cursor: pointer;
    opacity: 0.65;
    transition: width 180ms ease, border-radius 180ms ease, opacity 180ms ease;
  }

  #{{ sid }} .social-slider__dot.is-active {
    width: {{ section.settings.dot_active_width }}px;
    border-radius: 999px;
    background: var(--ss-dot-active);
    opacity: 1;
  }

  #{{ sid }} .social-slider__empty {
    width: 100%;
    padding: 40px 20px;
    text-align: center;
  }

  @media (hover: hover) {
    #{{ sid }} .social-slider__social:hover {
      transform: skewX({{ section.settings.social_skew }}deg) translateY(-2px);
      opacity: 0.85;
    }

    #{{ sid }} .social-slider__item[href]:hover .social-slider__image {
      transform: scale(1.04);
    }

    #{{ sid }} .social-slider__arrow:hover {
      transform: translateY(-50%) scale(1.06);
    }
  }

  @media screen and (max-width: 989px) {
    #{{ sid }} {
      --ss-visible: {{ section.settings.slides_tablet }};
    }
  }

  @media screen and (max-width: 749px) {
    #{{ sid }} {
      --ss-visible: {{ section.settings.slides_mobile }};
      --ss-gap: {{ section.settings.gap_mobile }}px;
      padding-block: var(--ss-pad-top-mobile) var(--ss-pad-bottom-mobile);
    }

    #{{ sid }} .social-slider__inner {
      width: min(calc(100% - 28px), var(--ss-width));
    }

    #{{ sid }} .social-slider__header {
      margin-bottom: {{ section.settings.header_spacing_mobile }}px;
    }

    #{{ sid }} .social-slider__heading {
      font-size: var(--ss-title-mobile);
    }

    #{{ sid }} .social-slider__text {
      font-size: {{ section.settings.text_size_mobile }}px;
    }

    #{{ sid }} .social-slider__socials {
      gap: {{ section.settings.social_gap_mobile }}px;
      margin-bottom: {{ section.settings.social_spacing_mobile }}px;
    }

    #{{ sid }} .social-slider__social {
      width: {{ section.settings.social_size_mobile }}px;
      height: {{ section.settings.social_size_mobile }}px;
    }

    #{{ sid }} .social-slider__caption {
      padding: 12px;
    }

    #{{ sid }} .social-slider__item-title {
      font-size: 13px;
    }

    #{{ sid }} .social-slider__item-caption {
      font-size: 10px;
    }

    #{{ sid }} .social-slider__arrow {
      width: {{ section.settings.arrow_size_mobile }}px;
      height: {{ section.settings.arrow_size_mobile }}px;
    }

    #{{ sid }}.social-slider--arrows-outside .social-slider__arrow--previous,
    #{{ sid }} .social-slider__arrow--previous {
      left: 6px;
    }

    #{{ sid }}.social-slider--arrows-outside .social-slider__arrow--next,
    #{{ sid }} .social-slider__arrow--next {
      right: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ sid }} .social-slider__viewport {
      scroll-behavior: auto;
    }

    #{{ sid }} .social-slider__social,
    #{{ sid }} .social-slider__image,
    #{{ sid }} .social-slider__arrow,
    #{{ sid }} .social-slider__dot {
      transition: none;
    }
  }
{% endstyle %}

<script>
  (() => {
    const root = document.getElementById('{{ sid }}');
    if (!root || root.dataset.sliderInitialized === 'true') return;

    root.dataset.sliderInitialized = 'true';

    const viewport = root.querySelector('[data-slider-viewport]');
    const track = root.querySelector('[data-slider-track]');
    const items = Array.from(root.querySelectorAll('[data-slider-item]'));
    const previous = root.querySelector('[data-slider-previous]');
    const next = root.querySelector('[data-slider-next]');
    const dotsContainer = root.querySelector('[data-slider-dots]');

    if (!viewport || !track || items.length === 0) return;

    const desktopVisible = Number(root.dataset.visibleDesktop || 5);
    const tabletVisible = Number(root.dataset.visibleTablet || 3);
    const mobileVisible = Number(root.dataset.visibleMobile || 2);
    const autoplayEnabled = root.dataset.autoplay === 'true';
    const autoplayDelay = Number(root.dataset.autoplayDelay || 4000);
    const loopEnabled = root.dataset.loop === 'true';

    let currentPage = 0;
    let pageCount = 1;
    let autoplayTimer = null;
    let scrollTimer = null;

    const visibleCount = () => {
      if (window.matchMedia('(max-width: 749px)').matches) return mobileVisible;
      if (window.matchMedia('(max-width: 989px)').matches) return tabletVisible;
      return desktopVisible;
    };

    const calculatePageCount = () => {
      pageCount = Math.max(1, Math.ceil(items.length / visibleCount()));
      currentPage = Math.min(currentPage, pageCount - 1);
    };

    const itemForPage = (page) => {
      const index = Math.min(page * visibleCount(), items.length - 1);
      return items[index];
    };

    const updateDots = () => {
      if (!dotsContainer) return;

      dotsContainer.innerHTML = '';

      if (pageCount <= 1) {
        dotsContainer.hidden = true;
        return;
      }

      dotsContainer.hidden = false;

      for (let index = 0; index < pageCount; index += 1) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'social-slider__dot';
        dot.setAttribute('aria-label', `Afficher la page ${index + 1} sur ${pageCount}`);
        dot.addEventListener('click', () => goToPage(index));
        dotsContainer.appendChild(dot);
      }
    };

    const updateControls = () => {
      const dots = dotsContainer ? Array.from(dotsContainer.children) : [];

      dots.forEach((dot, index) => {
        dot.classList.toggle('is-active', index === currentPage);
        dot.setAttribute('aria-current', index === currentPage ? 'true' : 'false');
      });

      const noNavigation = pageCount <= 1;

      if (previous) {
        previous.hidden = noNavigation;
        previous.disabled = !loopEnabled && currentPage === 0;
        previous.setAttribute('aria-disabled', previous.disabled ? 'true' : 'false');
      }

      if (next) {
        next.hidden = noNavigation;
        next.disabled = !loopEnabled && currentPage === pageCount - 1;
        next.setAttribute('aria-disabled', next.disabled ? 'true' : 'false');
      }
    };

    const goToPage = (page, behavior = 'smooth') => {
      if (pageCount <= 1) return;

      let targetPage = page;

      if (loopEnabled) {
        targetPage = (targetPage + pageCount) % pageCount;
      } else {
        targetPage = Math.max(0, Math.min(targetPage, pageCount - 1));
      }

      currentPage = targetPage;
      const target = itemForPage(currentPage);

      viewport.scrollTo({
        left: target.offsetLeft,
        behavior
      });

      updateControls();
    };

    const nearestPageFromScroll = () => {
      const visible = visibleCount();
      const firstWidth = items[0].getBoundingClientRect().width;
      const gap = parseFloat(window.getComputedStyle(track).columnGap || '0');
      const itemStep = firstWidth + gap;

      if (!itemStep) return 0;

      const nearestItem = Math.round(viewport.scrollLeft / itemStep);
      return Math.max(0, Math.min(Math.round(nearestItem / visible), pageCount - 1));
    };

    const stopAutoplay = () => {
      if (autoplayTimer) {
        window.clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    };

    const startAutoplay = () => {
      stopAutoplay();

      if (!autoplayEnabled || pageCount <= 1) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      autoplayTimer = window.setInterval(() => {
        if (document.hidden) return;

        if (currentPage >= pageCount - 1 && !loopEnabled) {
          goToPage(0);
        } else {
          goToPage(currentPage + 1);
        }
      }, autoplayDelay);
    };

    const rebuild = () => {
      calculatePageCount();
      updateDots();
      updateControls();
      goToPage(currentPage, 'auto');
      startAutoplay();
    };

    previous?.addEventListener('click', () => {
      goToPage(currentPage - 1);
      startAutoplay();
    });

    next?.addEventListener('click', () => {
      goToPage(currentPage + 1);
      startAutoplay();
    });

    viewport.addEventListener('scroll', () => {
      window.clearTimeout(scrollTimer);

      scrollTimer = window.setTimeout(() => {
        currentPage = nearestPageFromScroll();
        updateControls();
      }, 80);
    }, { passive: true });

    viewport.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goToPage(currentPage - 1);
      }

      if (event.key === 'ArrowRight') {
        event.preventDefault();
        goToPage(currentPage + 1);
      }
    });

    root.addEventListener('mouseenter', stopAutoplay);
    root.addEventListener('mouseleave', startAutoplay);
    root.addEventListener('focusin', stopAutoplay);
    root.addEventListener('focusout', startAutoplay);
    root.addEventListener('touchstart', stopAutoplay, { passive: true });
    root.addEventListener('touchend', startAutoplay, { passive: true });

    let resizeTimer = null;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(rebuild, 150);
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopAutoplay();
      } else {
        startAutoplay();
      }
    });

    rebuild();
  })();
</script>

