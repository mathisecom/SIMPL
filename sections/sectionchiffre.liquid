{% liquid
  assign section_id = 'key-stats-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="key-stats key-stats--{{ section.settings.style }}"
  style="
    --ks-background: {{ section.settings.background_color }};
    --ks-text: {{ section.settings.text_color }};
    --ks-muted: {{ section.settings.muted_color }};
    --ks-accent: {{ section.settings.accent_color }};
    --ks-divider: {{ section.settings.divider_color }};
    --ks-card-background: {{ section.settings.card_background }};
    --ks-content-width: {{ section.settings.content_width }}px;
    --ks-columns-desktop: {{ section.settings.columns_desktop }};
    --ks-columns-mobile: {{ section.settings.columns_mobile }};
    --ks-gap-desktop: {{ section.settings.gap_desktop }}px;
    --ks-gap-mobile: {{ section.settings.gap_mobile }}px;
    --ks-radius: {{ section.settings.card_radius }}px;
    --ks-shadow-opacity: {{ section.settings.shadow_opacity | divided_by: 100.0 }};
    --ks-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --ks-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --ks-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --ks-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --ks-value-size-desktop: {{ section.settings.value_size_desktop }}px;
    --ks-value-size-mobile: {{ section.settings.value_size_mobile }}px;
    --ks-title-size-desktop: {{ section.settings.title_size_desktop }}px;
    --ks-title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --ks-text-size-desktop: {{ section.settings.text_size_desktop }}px;
    --ks-text-size-mobile: {{ section.settings.text_size_mobile }}px;
    --ks-divider-height: {{ section.settings.divider_height }}%;
  "
>
  <div class="key-stats__inner">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.intro != blank %}
      <header class="key-stats__header key-stats__header--{{ section.settings.header_alignment }}">
        {% if section.settings.eyebrow != blank %}
          <p class="key-stats__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="key-stats__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}

        {% if section.settings.intro != blank %}
          <div class="key-stats__intro rte">{{ section.settings.intro }}</div>
        {% endif %}
      </header>
    {% endif %}

    <div
      class="key-stats__grid{% if section.settings.show_dividers %} key-stats__grid--dividers{% endif %}"
      role="list"
    >
      {% for block in section.blocks %}
        {% liquid
          assign item_tag = 'div'
          if block.settings.link != blank
            assign item_tag = 'a'
          endif
        %}

        <{{ item_tag }}
          class="key-stats__item key-stats__item--{{ block.settings.alignment }}"
          {% if block.settings.link != blank %}
            href="{{ block.settings.link }}"
            {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
            aria-label="{{ block.settings.value | escape }} {{ block.settings.title | escape }}"
          {% endif %}
          role="listitem"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.badge != blank %}
            <span class="key-stats__badge">{{ block.settings.badge | escape }}</span>
          {% endif %}

          {% if block.settings.value != blank %}
            <p class="key-stats__value">
              {% if block.settings.prefix != blank %}
                <span class="key-stats__prefix">{{ block.settings.prefix | escape }}</span>
              {% endif %}
              <span>{{ block.settings.value | escape }}</span>
              {% if block.settings.suffix != blank %}
                <span class="key-stats__suffix">{{ block.settings.suffix | escape }}</span>
              {% endif %}
            </p>
          {% endif %}

          {% if block.settings.title != blank %}
            <h3 class="key-stats__title">{{ block.settings.title | escape }}</h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <div class="key-stats__text rte">{{ block.settings.text }}</div>
          {% endif %}

          {% if block.settings.link_label != blank and block.settings.link != blank %}
            <span class="key-stats__link">
              {{ block.settings.link_label | escape }}
              <span aria-hidden="true">→</span>
            </span>
          {% endif %}
        </{{ item_tag }}>
      {% else %}
        <p class="key-stats__empty">Ajoutez des blocs « Chiffre clé » dans l’éditeur Shopify.</p>
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  #{{ section_id }} {
    width: 100%;
    background: var(--ks-background);
    color: var(--ks-text);
    padding-block: var(--ks-padding-top-desktop) var(--ks-padding-bottom-desktop);
  }

  #{{ section_id }} *,
  #{{ section_id }} *::before,
  #{{ section_id }} *::after {
    box-sizing: border-box;
  }

  #{{ section_id }} .key-stats__inner {
    width: min(calc(100% - 40px), var(--ks-content-width));
    margin-inline: auto;
  }

  #{{ section_id }} .key-stats__header {
    max-width: {{ section.settings.header_width }}px;
    margin-bottom: {{ section.settings.header_spacing }}px;
  }

  #{{ section_id }} .key-stats__header--left {
    margin-right: auto;
    text-align: left;
  }

  #{{ section_id }} .key-stats__header--center {
    margin-inline: auto;
    text-align: center;
  }

  #{{ section_id }} .key-stats__header--right {
    margin-left: auto;
    text-align: right;
  }

  #{{ section_id }} .key-stats__eyebrow {
    margin: 0 0 10px;
    color: var(--ks-accent);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  #{{ section_id }} .key-stats__heading {
    margin: 0;
    color: var(--ks-text);
    font-size: clamp(28px, 4vw, 52px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  #{{ section_id }} .key-stats__intro {
    margin-top: 16px;
    color: var(--ks-muted);
    font-size: 16px;
    line-height: 1.55;
  }

  #{{ section_id }} .key-stats__intro > *:first-child,
  #{{ section_id }} .key-stats__text > *:first-child {
    margin-top: 0;
  }

  #{{ section_id }} .key-stats__intro > *:last-child,
  #{{ section_id }} .key-stats__text > *:last-child {
    margin-bottom: 0;
  }

  #{{ section_id }} .key-stats__grid {
    display: grid;
    grid-template-columns: repeat(var(--ks-columns-desktop), minmax(0, 1fr));
    gap: var(--ks-gap-desktop);
    align-items: stretch;
  }

  #{{ section_id }} .key-stats__item {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: {{ section.settings.item_padding_vertical }}px {{ section.settings.item_padding_horizontal }}px;
    color: inherit;
    text-decoration: none;
    transition:
      transform 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  #{{ section_id }}.key-stats--cards .key-stats__item {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--ks-divider) 65%, transparent);
    border-radius: var(--ks-radius);
    background: var(--ks-card-background);
    box-shadow: 0 12px 34px rgba(0, 0, 0, var(--ks-shadow-opacity));
  }

  #{{ section_id }}.key-stats--accent-top .key-stats__item {
    border-top: 3px solid var(--ks-accent);
    border-radius: 0 0 var(--ks-radius) var(--ks-radius);
    background: var(--ks-card-background);
  }

  #{{ section_id }} .key-stats__item--left {
    align-items: flex-start;
    text-align: left;
  }

  #{{ section_id }} .key-stats__item--center {
    align-items: center;
    text-align: center;
  }

  #{{ section_id }} .key-stats__item--right {
    align-items: flex-end;
    text-align: right;
  }

  #{{ section_id }} .key-stats__badge {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    margin-bottom: 12px;
    padding: 5px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ks-accent) 12%, transparent);
    color: var(--ks-accent);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  #{{ section_id }} .key-stats__value {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: inherit;
    gap: 0.12em;
    margin: 0;
    color: var(--ks-text);
    font-size: var(--ks-value-size-desktop);
    font-weight: {{ section.settings.value_weight }};
    letter-spacing: -0.045em;
    line-height: 0.95;
  }

  #{{ section_id }} .key-stats__prefix,
  #{{ section_id }} .key-stats__suffix {
    font-size: 0.52em;
    letter-spacing: -0.01em;
  }

  #{{ section_id }} .key-stats__title {
    margin: 12px 0 0;
    color: var(--ks-text);
    font-size: var(--ks-title-size-desktop);
    font-weight: {{ section.settings.title_weight }};
    letter-spacing: -0.018em;
    line-height: 1.15;
  }

  #{{ section_id }} .key-stats__text {
    margin-top: 8px;
    color: var(--ks-muted);
    font-size: var(--ks-text-size-desktop);
    line-height: 1.45;
  }

  #{{ section_id }} .key-stats__link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 14px;
    color: var(--ks-accent);
    font-size: 13px;
    font-weight: 700;
  }

  #{{ section_id }} .key-stats__grid--dividers .key-stats__item:not(:first-child)::before {
    position: absolute;
    top: calc((100% - var(--ks-divider-height)) / 2);
    bottom: calc((100% - var(--ks-divider-height)) / 2);
    left: calc(var(--ks-gap-desktop) / -2);
    width: 1px;
    background: var(--ks-divider);
    content: "";
  }

  #{{ section_id }} .key-stats__empty {
    grid-column: 1 / -1;
    margin: 0;
    padding: 24px;
    text-align: center;
  }

  @media (hover: hover) {
    #{{ section_id }} .key-stats__item[href]:hover {
      transform: translateY(-3px);
    }

    #{{ section_id }}.key-stats--cards .key-stats__item[href]:hover {
      box-shadow: 0 18px 42px rgba(0, 0, 0, calc(var(--ks-shadow-opacity) + 0.04));
    }

    #{{ section_id }} .key-stats__item[href]:hover .key-stats__link span {
      transform: translateX(3px);
    }

    #{{ section_id }} .key-stats__link span {
      transition: transform 180ms ease;
    }
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      padding-block: var(--ks-padding-top-mobile) var(--ks-padding-bottom-mobile);
    }

    #{{ section_id }} .key-stats__inner {
      width: min(calc(100% - 28px), var(--ks-content-width));
    }

    #{{ section_id }} .key-stats__header {
      margin-bottom: {{ section.settings.header_spacing_mobile }}px;
      {% if section.settings.mobile_header_alignment == 'left' %}
        margin-right: auto;
        margin-left: 0;
        text-align: left;
      {% elsif section.settings.mobile_header_alignment == 'center' %}
        margin-inline: auto;
        text-align: center;
      {% else %}
        margin-right: 0;
        margin-left: auto;
        text-align: right;
      {% endif %}
    }

    #{{ section_id }} .key-stats__heading {
      font-size: clamp(25px, 9vw, 38px);
    }

    #{{ section_id }} .key-stats__intro {
      font-size: 14px;
    }

    #{{ section_id }} .key-stats__grid {
      grid-template-columns: repeat(var(--ks-columns-mobile), minmax(0, 1fr));
      gap: var(--ks-gap-mobile);
    }

    #{{ section_id }} .key-stats__item {
      padding: {{ section.settings.item_padding_vertical_mobile }}px {{ section.settings.item_padding_horizontal_mobile }}px;
    }

    #{{ section_id }} .key-stats__value {
      font-size: var(--ks-value-size-mobile);
    }

    #{{ section_id }} .key-stats__title {
      margin-top: 9px;
      font-size: var(--ks-title-size-mobile);
    }

    #{{ section_id }} .key-stats__text {
      font-size: var(--ks-text-size-mobile);
    }

    #{{ section_id }} .key-stats__grid--dividers .key-stats__item::before {
      display: none;
    }

    {% if section.settings.columns_mobile == '1' %}
      #{{ section_id }} .key-stats__grid--dividers .key-stats__item:not(:first-child)::before {
        display: block;
        top: calc(var(--ks-gap-mobile) / -2);
        right: 8%;
        bottom: auto;
        left: 8%;
        width: auto;
        height: 1px;
      }
    {% elsif section.settings.columns_mobile == '2' %}
      #{{ section_id }} .key-stats__grid--dividers .key-stats__item:nth-child(even)::before {
        display: block;
        top: 10%;
        bottom: 10%;
        left: calc(var(--ks-gap-mobile) / -2);
        width: 1px;
      }

      #{{ section_id }} .key-stats__grid--dividers .key-stats__item:nth-child(n + 3)::after {
        position: absolute;
        top: calc(var(--ks-gap-mobile) / -2);
        right: 8%;
        left: 8%;
        height: 1px;
        background: var(--ks-divider);
        content: "";
      }
    {% elsif section.settings.columns_mobile == '3' %}
      #{{ section_id }} .key-stats__grid--dividers .key-stats__item:not(:nth-child(3n + 1))::before {
        display: block;
        top: 8%;
        bottom: 8%;
        left: calc(var(--ks-gap-mobile) / -2);
        width: 1px;
      }

      #{{ section_id }} .key-stats__grid--dividers .key-stats__item:nth-child(n + 4)::after {
        position: absolute;
        top: calc(var(--ks-gap-mobile) / -2);
        right: 6%;
        left: 6%;
        height: 1px;
        background: var(--ks-divider);
        content: "";
      }
    {% endif %}
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} .key-stats__item,
    #{{ section_id }} .key-stats__link span {
      transition: none;
    }
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} .key-stats__grid[style*="--ks-columns-mobile: 3"],
    #{{ section_id }} .key-stats__grid {
      min-width: 0;
    }

    {% if section.settings.columns_mobile == '3' %}
      #{{ section_id }} .key-stats__item {
        min-width: 0;
      }

      #{{ section_id }} .key-stats__value {
        overflow-wrap: anywhere;
        word-break: break-word;
      }

      #{{ section_id }} .key-stats__title,
      #{{ section_id }} .key-stats__text {
        overflow-wrap: anywhere;
      }

      #{{ section_id }} .key-stats__badge {
        max-width: 100%;
        padding-inline: 6px;
        white-space: normal;
        text-align: center;
      }
    {% endif %}
  }

{% endstyle %}

{% schema %}
{
  "name": "Chiffres clés premium",
  "tag": "section",
  "class": "section-key-stats",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "En-tête"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit titre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre principal"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Texte d’introduction"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Alignement de l’en-tête sur ordinateur",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Gauche"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Droite"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_header_alignment",
      "label": "Alignement de l’en-tête sur mobile",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Gauche"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Droite"
        }
      ]
    },
    {
      "type": "range",
      "id": "header_width",
      "label": "Largeur maximale de l’en-tête",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 800
    },
    {
      "type": "range",
      "id": "header_spacing",
      "label": "Espace sous l’en-tête sur ordinateur",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "header_spacing_mobile",
      "label": "Espace sous l’en-tête sur mobile",
      "min": 0,
      "max": 72,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style visuel",
      "default": "minimal",
      "options": [
        {
          "value": "minimal",
          "label": "Minimal avec séparateurs"
        },
        {
          "value": "cards",
          "label": "Cartes"
        },
        {
          "value": "accent-top",
          "label": "Trait coloré supérieur"
        }
      ]
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Largeur maximale du contenu",
      "min": 900,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Colonnes sur ordinateur",
      "default": "3",
      "options": [
        {
          "value": "2",
          "label": "2 colonnes"
        },
        {
          "value": "3",
          "label": "3 colonnes"
        },
        {
          "value": "4",
          "label": "4 colonnes"
        }
      ]
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Colonnes sur mobile",
      "default": "3",
      "options": [
        {
          "value": "1",
          "label": "1 colonne"
        },
        {
          "value": "2",
          "label": "2 colonnes"
        },
        {
          "value": "3",
          "label": "3 colonnes"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Afficher les séparateurs",
      "default": true
    },
    {
      "type": "range",
      "id": "divider_height",
      "label": "Hauteur des séparateurs sur ordinateur",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Espacement sur ordinateur",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Espacement sur mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "item_padding_vertical",
      "label": "Marge interne verticale sur ordinateur",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "item_padding_horizontal",
      "label": "Marge interne horizontale sur ordinateur",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "item_padding_vertical_mobile",
      "label": "Marge interne verticale sur mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "item_padding_horizontal_mobile",
      "label": "Marge interne horizontale sur mobile",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Arrondi des cartes",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "shadow_opacity",
      "label": "Intensité de l’ombre",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "%",
      "default": 6
    },
    {
      "type": "header",
      "content": "Typographie"
    },
    {
      "type": "range",
      "id": "value_size_desktop",
      "label": "Taille du chiffre sur ordinateur",
      "min": 28,
      "max": 90,
      "step": 2,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "value_size_mobile",
      "label": "Taille du chiffre sur mobile",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "select",
      "id": "value_weight",
      "label": "Graisse du chiffre",
      "default": "700",
      "options": [
        {
          "value": "400",
          "label": "Normale"
        },
        {
          "value": "500",
          "label": "Moyenne"
        },
        {
          "value": "600",
          "label": "Semi-grasse"
        },
        {
          "value": "700",
          "label": "Grasse"
        },
        {
          "value": "800",
          "label": "Très grasse"
        }
      ]
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Taille du titre sur ordinateur",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Taille du titre sur mobile",
      "min": 12,
      "max": 26,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Graisse du titre",
      "default": "500",
      "options": [
        {
          "value": "400",
          "label": "Normale"
