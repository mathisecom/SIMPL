{% comment %}
  Section: Témoignages clients avec photos
  Thème: Shrine (Shopify)
{% endcomment %}

<style>
  .testi {
    background-color: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    overflow: hidden;
  }

  .testi__header {
    text-align: center;
    padding: 0 20px;
    margin-bottom: 40px;
  }

  .testi__stars {
    color: {{ section.settings.accent_color }};
    font-size: 28px;
    letter-spacing: 4px;
    margin-bottom: 16px;
  }

  .testi__title {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 800;
    color: #222;
    line-height: 1.15;
    margin: 0 0 16px;
  }

  .testi__title-accent {
    color: {{ section.settings.accent_color }};
    font-style: italic;
    display: block;
  }

  .testi__subtitle {
    font-size: 16px;
    color: #888;
    margin: 0;
  }

  .testi__photos-wrapper {
    overflow: hidden;
    width: 100%;
    margin-bottom: 40px;
  }

  .testi__photos {
    display: flex;
    gap: 6px;
    width: max-content;
  }

  .testi__photo {
    flex-shrink: 0;
    width: {{ section.settings.photo_width }}px;
    height: {{ section.settings.photo_height }}px;
    border-radius: 16px;
    overflow: hidden;
  }

  .testi__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .testi__photo-placeholder {
    width: 100%;
    height: 100%;
    background: #ddd;
  }

  .testi__carousel-wrapper {
    position: relative;
    padding: 0 60px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .testi__carousel { overflow: hidden; }

  .testi__track {
    display: flex;
    gap: 20px;
    transition: transform 0.4s ease;
  }

  .testi__card {
    flex-shrink: 0;
    width: calc(33.33% - 14px);
    background: #fff;
    border-radius: 16px;
    padding: 28px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  }

  .testi__card-top {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .testi__card-score {
    font-size: 16px;
    font-weight: 700;
    color: #222;
  }

  .testi__card-stars {
    color: {{ section.settings.accent_color }};
    font-size: 16px;
    letter-spacing: 1px;
  }

  .testi__card-text {
    font-size: 14px;
    color: #444;
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  .testi__card-author {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
  }

  .testi__card-author-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .testi__card-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: #eee;
  }

  .testi__card-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .testi__card-name {
    font-size: 14px;
    font-weight: 700;
    color: #222;
  }

  .testi__card-verified {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    font-weight: 600;
    color: {{ section.settings.accent_color }};
    white-space: nowrap;
  }

  .testi__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid rgba(0,0,0,0.1);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    color: #333;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    transition: opacity 0.2s;
    z-index: 2;
    padding: 0;
  }

  .testi__arrow:hover { opacity: 0.7; }
  .testi__arrow--prev { left: 0; }
  .testi__arrow--next { right: 0; }
  .testi__arrow.hidden { opacity: 0; pointer-events: none; }

  .testi__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 32px;
  }

  .testi__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ccc;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 0.2s;
  }

  .testi__dot.active { background: {{ section.settings.accent_color }}; }

  @media (max-width: 900px) {
    .testi__card { width: calc(50% - 10px); }
  }

  @media (max-width: 600px) {
    .testi__card { width: 85vw; }
    .testi__carousel-wrapper { padding: 0 40px; }
  }
</style>

<section class="testi" id="testi-{{ section.id }}">

  <div class="testi__header">
    <div class="testi__stars">★★★★★</div>
    <h2 class="testi__title">
      {{ section.settings.title_line1 }}
      <span class="testi__title-accent">{{ section.settings.title_line2 }}</span>
    </h2>
    {% if section.settings.subtitle != blank %}
      <p class="testi__subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}
  </div>

  {% assign photo_blocks = section.blocks | where: 'type', 'photo' %}
  {% if photo_blocks.size > 0 %}
  <div class="testi__photos-wrapper" id="testi-photos-wrapper-{{ section.id }}">
    <div class="testi__photos" id="testi-photos-{{ section.id }}">
      {% for block in photo_blocks %}
        <div class="testi__photo">
          {% if block.settings.photo != blank %}
            <img src="{{ block.settings.photo | image_url: width: 600 }}" alt="">
          {% else %}
            <div class="testi__photo-placeholder"></div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <div class="testi__carousel-wrapper" style="margin-top: 40px;">
    <button class="testi__arrow testi__arrow--prev" id="testi-prev-{{ section.id }}">&#8249;</button>
    <div class="testi__carousel">
      <div class="testi__track" id="testi-track-{{ section.id }}">
        {% assign review_blocks = section.blocks | where: 'type', 'review' %}
        {% for block in review_blocks %}
          <div class="testi__card">
            <div class="testi__card-top">
              <span class="testi__card-score">{{ block.settings.score }}</span>
              <span class="testi__card-stars">★★★★★</span>
            </div>
            <p class="testi__card-text">{{ block.settings.review_text }}</p>
            <div class="testi__card-author">
              <div class="testi__card-author-left">
                <div class="testi__card-avatar">
                  {% if block.settings.avatar != blank %}
                    <img src="{{ block.settings.avatar | image_url: width: 100 }}" alt="{{ block.settings.author_name | escape }}" loading="lazy">
                  {% endif %}
                </div>
                <span class="testi__card-name">{{ block.settings.author_name }}</span>
              </div>
              <div class="testi__card-verified">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.accent_color }}" stroke-width="2"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                CLIENT VÉRIFIÉ
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
    <button class="testi__arrow testi__arrow--next" id="testi-next-{{ section.id }}">&#8250;</button>
  </div>

  <div class="testi__dots" id="testi-dots-{{ section.id }}"></div>

</section>

<script>
(function() {

  /* ── Carousel photos ── */
  var photosWrapper = document.getElementById('testi-photos-wrapper-{{ section.id }}');
  var photosTrack   = document.getElementById('testi-photos-{{ section.id }}');

  if (photosWrapper && photosTrack) {

    function initPhotos() {
      var originalWidth = photosTrack.scrollWidth;
      var wrapperWidth  = photosWrapper.offsetWidth;

      if (originalWidth === 0) {
        setTimeout(initPhotos, 200);
        return;
      }

      var copies = Math.ceil((wrapperWidth * 3) / originalWidth) + 2;
      var cards  = Array.prototype.slice.call(photosTrack.querySelectorAll('.testi__photo'));

      for (var i = 0; i < copies; i++) {
        cards.forEach(function(card) {
          var clone = card.cloneNode(true);
          clone.setAttribute('aria-hidden', 'true');
          photosTrack.appendChild(clone);
        });
      }

      var groupWidth = originalWidth;
      var pos    = 0;
      var last   = null;
      var paused = false;
      var speed  = {{ section.settings.photo_speed }};

      /* Pause uniquement sur desktop avec souris — jamais sur mobile */
      if (window.matchMedia('(hover: hover)').matches) {
        photosWrapper.addEventListener('mouseenter', function() { paused = true; });
        photosWrapper.addEventListener('mouseleave', function() { paused = false; });
      }

      function animate(ts) {
        if (last === null) last = ts;
        var delta = (ts - last) / 1000;
        last = ts;
        if (!paused) {
          pos += speed * delta;
          if (pos >= groupWidth) pos -= groupWidth;
          photosTrack.style.transform = 'translateX(-' + pos + 'px)';
        }
        requestAnimationFrame(animate);
      }

      requestAnimationFrame(animate);
    }

    /* Retirer lazy loading + attendre DOM stable */
    var imgs = photosTrack.querySelectorAll('img');
    imgs.forEach(function(img) { img.removeAttribute('loading'); });
    setTimeout(function() { initPhotos(); }, 300);
  }

  /* ── Carousel avis ── */
  var track   = document.getElementById('testi-track-{{ section.id }}');
  var prevBtn = document.getElementById('testi-prev-{{ section.id }}');
  var nextBtn = document.getElementById('testi-next-{{ section.id }}');
  var dotsEl  = document.getElementById('testi-dots-{{ section.id }}');
  if (!track) return;

  var cards   = track.querySelectorAll('.testi__card');
  var total2  = cards.length;
  var current = 0;

  function getVisible() {
    return window.innerWidth < 600 ? 1 : window.innerWidth < 900 ? 2 : 3;
  }

  function getMax() {
    return Math.max(0, total2 - getVisible());
  }

  function buildDots() {
    dotsEl.innerHTML = '';
    var count = getMax() + 1;
    for (var d = 0; d < count; d++) {
      var dot = document.createElement('button');
      dot.className = 'testi__dot' + (d === 0 ? ' active' : '');
      dot.setAttribute('data-index', d);
      dot.addEventListener('click', function() { goTo(parseInt(this.getAttribute('data-index'))); });
      dotsEl.appendChild(dot);
    }
  }

  function goTo(index) {
    var max = getMax();
    current = Math.max(0, Math.min(index, max));
    var cardWidth = cards[0].offsetWidth + 20;
    track.style.transform = 'translateX(-' + (current * cardWidth) + 'px)';
    prevBtn.classList.toggle('hidden', current === 0);
    nextBtn.classList.toggle('hidden', current >= max);
    dotsEl.querySelectorAll('.testi__dot').forEach(function(d, i) {
      d.classList.toggle('active', i === current);
    });
  }

  prevBtn.addEventListener('click', function() { goTo(current - 1); });
  nextBtn.addEventListener('click', function() { goTo(current + 1); });
  window.addEventListener('resize', function() { buildDots(); goTo(Math.min(current, getMax())); });

  buildDots();
  goTo(0);

})();
</script>

{% schema %}
{
  "name": "Témoignages clients",
  "tag": "section",
  "class": "testi-section",
  "settings": [
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Couleur de fond",
      "default": "#f5f0e8"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur accent",
      "default": "#00b5ad"
    },
    {
      "type": "header",
      "content": "Espacement"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding haut (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bas (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "header",
      "content": "Textes"
    },
    {
      "type": "text",
      "id": "title_line1",
      "label": "Titre ligne 1",
      "default": "Des histoires vraies,"
    },
    {
      "type": "text",
      "id": "title_line2",
      "label": "Titre ligne 2 (accent italique)",
      "default": "des résultats concrets"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Découvrez ce que nos clients disent de DEOS®"
    },
    {
      "type": "header",
      "content": "Photos clients"
    },
    {
      "type": "range",
      "id": "photo_width",
      "label": "Largeur des photos (px)",
      "min": 80,
      "max": 400,
      "step": 10,
      "default": 180
    },
    {
      "type": "range",
      "id": "photo_height",
      "label": "Hauteur des photos (px)",
      "min": 80,
      "max": 500,
      "step": 10,
      "default": 230
    },
    {
      "type": "range",
      "id": "photo_speed",
      "label": "Vitesse défilement (px/sec)",
      "min": 20,
      "max": 200,
      "step": 10,
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo client",
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Photo"
        }
      ]
    },
    {
      "type": "review",
      "name": "Avis client",
      "settings": [
        {
          "type": "text",
          "id": "score",
          "label": "Note (ex: 4.9)",
          "default": "4.9"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Texte de l'avis",
          "default": "Produit incroyable !"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Photo de profil"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Nom",
          "default": "Tamika R."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Témoignages clients",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}